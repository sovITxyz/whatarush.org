# Cloudflare Pages caching (Pages ignores .htaccess). Mirrors public/.htaccess.
# Hashed build output — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media has stable, non-hashed names — 30 days + background refresh.
# When replacing a media file's content, rename it (or add ?v=N) so warm
# caches pick it up.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800
